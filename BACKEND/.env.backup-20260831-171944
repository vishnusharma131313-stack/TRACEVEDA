# TraceVeda backend configuration.
#
# Copy to .env and fill in. Everything here has a working development
# default, so the API starts without this file - but it starts UNHARDENED
# and says so in its logs and in GET /api/health ("hardened": false).
#
# .env is gitignored. Never commit real secrets.


# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://vishnusharma131313_db_user:TraceVeda_SIH2026@tracevedadb.qryym2l.mongodb.net/?appName=TraceVedaDB
DB_NAME=traceveda
MONGO_TIMEOUT_MS=5000


# ---------------------------------------------------------------
# AUTHENTICATION  (required for anything but a local demo)
# ---------------------------------------------------------------
# Signing key for access tokens. If unset, a random key is generated per
# process, which means every token stops working when the server restarts.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TRACEVEDA_JWT_SECRET=

# How long an access token stays valid. 720 = 12 hours.
TRACEVEDA_TOKEN_MINUTES=720

# Password given to every account created by seed_users.py.
TRACEVEDA_DEMO_PASSWORD=traceveda2026


# ---------------------------------------------------------------
# IOT DEVICE INGEST
# ---------------------------------------------------------------
# Shared key the ESP32 nodes send as the X-Device-Key header on
# POST /api/iot/readings. Flash the same value into:
#   HARDWARE/Storage_Node/Storage_Node_Backend/Storage_Node_Backend.ino
#   HARDWARE/Truck_Node/Truck_Node_Backend/Truck_Node_Backend.ino
TRACEVEDA_DEVICE_API_KEY=


# ---------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
# 5173 is `npm run dev`, 4173 is `npm run preview`.
# Add your deployed frontend origin here; do NOT use "*".
TRACEVEDA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173


# ---------------------------------------------------------------
# QUERY LIMITS
# ---------------------------------------------------------------
TRACEVEDA_PAGE_SIZE=200
TRACEVEDA_MAX_PAGE_SIZE=2000
