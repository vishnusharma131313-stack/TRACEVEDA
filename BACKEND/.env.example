# Copy to .env for local development. Keep actual secrets out of Git.
MONGO_URI=mongodb://localhost:27017
DB_NAME=traceveda
TRACEVEDA_JWT_SECRET=replace-with-a-long-random-secret-before-deployment
TRACEVEDA_DEVICE_API_KEY=replace-with-your-device-key
TRACEVEDA_CORS_ORIGINS=https://traceveda.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Public TraceVeda Assistant (server-side only; never put this key in Vercel frontend variables)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
TRACEVEDA_ASSISTANT_SESSION_DAYS=30
