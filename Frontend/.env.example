# Frontend configuration. Copy to .env.
#
# Base URL of the TraceVeda API.
#
#   http://localhost:8000   direct calls; the backend's TRACEVEDA_CORS_ORIGINS
#                           must list this dev server's origin (it does by
#                           default: http://localhost:5173)
#
#   (blank)                 same-origin calls routed through the Vite dev
#                           proxy in vite.config.js, so CORS never applies
#
# For a production build, set this to the deployed API origin and add the
# frontend's origin to TRACEVEDA_CORS_ORIGINS in BACKEND/.env.
VITE_API_URL=http://localhost:8000
